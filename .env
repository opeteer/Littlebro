# Littlebro Environment Variables

# Backend & Redis
REDIS_URL=redis://redis:6341/0
FRONTEND_CORS_ORIGINS=http://localhost,http://localhost:3041

# Open Data API Keys (Optional but recommended for high throughput)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# NASA LANCE/FIRMS (Required for Module 9)
NASA_FIRMS_MAP_KEY=

# Telegram Open-News (Optional for Module 15 - if using Telethon instead of web scraper)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
